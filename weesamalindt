echo "# weesamalindt" >> README.md

# Create .gitignore with security defaults
cat << 'EOF' > .gitignore
# Dependencies
node_modules/
dist/
venv/
__pycache__/

# Environment variables
.env
.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Secrets
*.pem
*.key
id_rsa
id_rsa.pub
*.pfx
*.p12

# IDE settings
.vscode/
.idea/
EOF

git init
git add README.md .gitignore
git commit -m "first commit"
git branch -M main
git remote add origin https://github.com/Weesamalindt/weesamalindt.git
git push -u origin main
