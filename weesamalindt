# Create .gitignore with security defaults
cat <<EOF > .gitignore
# Dependencies
node_modules/
venv/
dist/
build/
coverage/

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/

# Secrets
*.pem
*.key
id_rsa
EOF

echo "# weesamalindt" >> README.md
git init
git add README.md .gitignore
git commit -m "first commit"
git branch -M main
git remote add origin https://github.com/Weesamalindt/weesamalindt.git
git push -u origin main
